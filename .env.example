# CQIP environment configuration.
# Every setting is read from the CQIP_-prefixed environment or a .env file.
# Copy to `.env` and adjust. All values below are the built-in defaults.

# --- Application -----------------------------------------------------------
CQIP_APP_NAME=crypto-quant-intelligence-platform
CQIP_ENVIRONMENT=development
CQIP_DEBUG=false
CQIP_LOG_LEVEL=INFO
CQIP_LOG_FORMAT=console

# --- Storage ---------------------------------------------------------------
# Parquet datasets, model artifacts, the SQLite DB and the HTTP cache all live
# under DATA_DIR unless overridden individually.
CQIP_DATA_DIR=./data
# CQIP_PARQUET_DIR=./data/parquet
# CQIP_ARTIFACT_DIR=./data/artifacts
# CQIP_DB_URL=sqlite:///./data/cqip.db

# --- Market data -----------------------------------------------------------
CQIP_DEFAULT_EXCHANGE=gate
CQIP_DEFAULT_QUOTE=USDT
# JSON list, as pydantic-settings parses complex types.
CQIP_DEFAULT_SYMBOLS=["BTC_USDT"]
CQIP_HTTP_TIMEOUT=30
CQIP_HTTP_MAX_CONNECTIONS=20
CQIP_HTTP_MAX_RETRIES=4
CQIP_HTTP_BACKOFF_BASE=0.8
CQIP_HTTP_BACKOFF_MAX=30
# CQIP_USER_AGENT=cqip/0.1 (+https://your-project.example)

# --- Sentiment -------------------------------------------------------------
CQIP_SENTIMENT_MODEL=distilbert-base-uncased-finetuned-sst-2-english
CQIP_SENTIMENT_BATCH_SIZE=16
CQIP_SENTIMENT_MAX_LENGTH=256
# Set false to force the lexicon fallback and avoid the model download
# (required for offline or air-gapped runs).
CQIP_ALLOW_MODEL_DOWNLOAD=true

# --- Forecaster ------------------------------------------------------------
CQIP_FORECASTER_KIND=lstm
CQIP_FORECASTER_HIDDEN_SIZE=128
CQIP_FORECASTER_NUM_LAYERS=2
CQIP_FORECASTER_DROPOUT=0.1
CQIP_FORECASTER_SEQ_LEN=64
CQIP_FORECASTER_EPOCHS=30
CQIP_FORECASTER_BATCH_SIZE=64
CQIP_FORECASTER_LR=0.001
CQIP_FORECASTER_PATIENCE=6
CQIP_SEED=42

# --- Reinforcement learning ------------------------------------------------
CQIP_RL_ALGORITHM=PPO
CQIP_RL_TIMESTEPS=20000
CQIP_RL_LEARNING_RATE=0.0003
CQIP_RL_BATCH_SIZE=64
CQIP_RL_N_ENVS=1
CQIP_RL_INITIAL_CAPITAL=10000

# --- Backtest --------------------------------------------------------------
CQIP_BACKTEST_INITIAL_CAPITAL=10000
CQIP_BACKTEST_FEE_BPS=10
CQIP_BACKTEST_SLIPPAGE_BPS=5
CQIP_BACKTEST_TRAIN_RATIO=0.7
CQIP_BACKTEST_VAL_RATIO=0.15
# expanding | rolling
CQIP_BACKTEST_ANCHOR=expanding

# --- API server ------------------------------------------------------------
CQIP_API_HOST=127.0.0.1
CQIP_API_PORT=8000
# Restrict this to your frontend origin outside local development.
CQIP_CORS_ORIGINS=["*"]
